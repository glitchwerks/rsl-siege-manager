{
  "activation": "separately-approved",
  "receiver": "independent-missed-signal-service",
  "notifications": {
    "primary": "infrastructure-slack",
    "fallback": "email",
    "failure": "first-completed-failed-observation",
    "recovery": "next-completed-passing-observation",
    "incomplete_or_absent_observation": "missed-signal-deadline"
  },
  "signals": {
    "public_web_api_tls": {
      "sender": "scripts/portable-vps-public-monitor.py",
      "location": "outside-production-vps",
      "period_seconds": 300,
      "grace_seconds": 600,
      "certificate_minimum_remaining_days": 14
    },
    "runtime_gateway_scheduler": {
      "sender": "scripts/portable-monitor.py",
      "location": "production-vps",
      "period_seconds": 900,
      "grace_seconds": 600
    },
    "database_readiness_pressure": {
      "sender": "scripts/portable-vps-database-monitor.py",
      "location": "production-vps",
      "period_seconds": 300,
      "grace_seconds": 900,
      "thresholds": "review-after-live-measurements"
    },
    "host_pressure": {
      "sender": "scripts/portable-vps-host-monitor.py",
      "location": "production-vps",
      "period_seconds": 300,
      "grace_seconds": 900,
      "thresholds": "review-after-live-measurements"
    },
    "managed_encrypted_backup": {
      "sender": "existing-managed-backup-job",
      "location": "production-vps",
      "period_seconds": 3600,
      "grace_seconds": 2400,
      "success_requires": "encrypted-object-and-independent-receipt-readback"
    }
  },
  "watchdog": "separately-reviewed-bounded-service-recovery"
}
