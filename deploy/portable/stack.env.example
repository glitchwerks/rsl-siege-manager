# Image references must be repository@sha256:<64 hex characters>.
# Populate from CI/registry metadata, never deploy these placeholders.
COMPOSE_PROJECT_NAME=siege-pilot
BACKEND_IMAGE=registry.example/siege-backend@sha256:REPLACE
FRONTEND_IMAGE=registry.example/siege-frontend@sha256:REPLACE
BOT_IMAGE=registry.example/siege-bot@sha256:REPLACE
MOM_IMAGE=ghcr.io/glitchwerks/mom-bot@sha256:REPLACE
POSTGRES_IMAGE=postgres@sha256:REPLACE
CADDY_IMAGE=caddy@sha256:REPLACE
PUBLIC_HOST=siege-pilot.example.com
ACME_EMAIL=operator@example.com
# Inspect host routes/networks before choosing these; not safe universal defaults.
PROXY_SUBNET=172.30.60.0/28
# Dynamic endpoints must never consume the fixed proxy address.
PROXY_DYNAMIC_RANGE=172.30.60.8/29
PROXY_IP=172.30.60.2
