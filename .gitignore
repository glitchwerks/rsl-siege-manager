# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env
*.env.local

# Node
node_modules/
dist/
.next/
out/
*.local

# Vite
.vite/

# Vite plugin source (frontend/src/build/) is production TypeScript source — not a build artifact.
# The top-level `build/` rule above would otherwise ignore it.
!frontend/src/build/
!frontend/src/test/build/

# Coverage
.coverage
htmlcov/
.pytest_cache/
coverage.xml
*.lcov

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.claude/worktrees/
.claude/agent-memory/
.claude/scheduled_tasks.lock
.worktrees/

# Docker
.dockerignore
!backend/.dockerignore
!bot/.dockerignore

# Azure
.azure/
.env.deploy.*
# Compiled ARM output — regenerated by `az bicep build`; do not commit.
infra/main.json

# Secrets
scripts/*.pem
scripts/*.pfx
scripts/*.cert

# Logs
*.log
logs/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-mcp/

# Claude Code local config
frontend/.claude/

# graphify build artifacts (graph.json/html, manifest, cache).
# Bookkeeping (consultations + misfires) lives in docs/graphify-bookkeeping/
# and IS tracked — do not move it under graphify-out/.
graphify-out/
